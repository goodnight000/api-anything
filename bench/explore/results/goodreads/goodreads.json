            "path:2"
          ]
        }
      ],
      "volatile": [],
      "trigger": {
        "url": "https://www.goodreads.com/book/show/{bookId}"
      },
      "match": {
        "method": "GET",
        "host": "www.goodreads.com",
        "path": "/book/show/*"
      },
      "response": {
        "format": "html",
        "contentType": "text/html; charset=utf-8",
        "html": {
          "items": "body",
          "fields": {
            "title": "[data-testid=\"bookTitle\"]",
            "author": "[data-testid=\"name\"]",
            "authorUrl": ".ContributorLink@href",
            "avgRating": ".RatingStatistics__rating",
            "ratingsCount": "[data-testid=\"ratingsCount\"]",
            "pages": "[data-testid=\"pagesFormat\"]",
            "firstPublished": "[data-testid=\"publicationInfo\"]",
            "genres": "all:[data-testid=\"genresList\"] a span.Button__labelItem",
            "description": "[data-testid=\"description\"] span.Formatted"
          }
        }
      },
      "params": [
        {
          "name": "bookId",
          "type": "string",
          "required": true,
          "example": "77566"
