          "x-browser-channel": "stable",
          "x-browser-copyright": "Copyright 2026 Google LLC. All Rights Reserved.",
          "x-browser-validation": "i4EyS5V7KAFMVdi4watYsPhpgkI=",
          "x-browser-year": "2026"
        }
      },
      "slots": [
        {
          "param": "origin",
          "at": [
            "query:q"
          ],
          "template": "Flights from {origin} to {destination} on {date} one way"
        }
      ],
      "volatile": [],
      "trigger": {
        "url": "https://www.google.com/travel/flights?q=Flights%20from%20{origin}%20to%20{destination}%20on%20{date}%20one%20way&hl=en-US&gl=US&curr=USD"
      },
      "match": {
        "method": "GET",
        "host": "www.google.com",
        "path": "/travel/flights"
      },
      "response": {
        "format": "embedded",
        "contentType": "text/html; charset=utf-8",
        "extract": "[3][0]",
        "pick": [
          "airline=[0][1]",
          "price=[1][0][1]",
          "from=[0][3]",
          "to=[0][6]",
          "departureTime=[0][5]",
          "arrivalDate=[0][7]",
          "arrivalTime=[0][8]",
          "durationMinutes=[0][9]",
          "via=[0][13][*][1]"
        ],
        "embedded": {
          "regex": "key: 'ds:1', hash: '\\d+', data:(\\[)"
        }
      },
      "params": [
        {
          "name": "origin",
          "type": "string",
          "required": true,
          "description": "origin: airport code, metro code or city name, e.g. SFO",
          "example": "SFO",
          "pattern": "^\\D{2,60}$",
          "hint": "an airport code (JFK), a metro code (NYC, LON, TYO) or a city name (New York, Paris); Google reads it as free text"
        },
        {
          "name": "destination",
          "type": "string",
          "required": true,
          "description": "destination: airport code, metro code or city name, e.g. NYC",
          "example": "NYC",
          "pattern": "^\\D{2,60}$",
          "hint": "an airport code (JFK), a metro code (NYC, LON, TYO) or a city name (New York, Paris); Google reads it as free text"
        },
        {
          "name": "date",
          "type": "string",
          "required": true,
          "description": "departure date YYYY-MM-DD, today or later",
          "example": "2027-04-15",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "hint": "a departure date as YYYY-MM-DD, e.g. 2027-04-15"
        }
      ],
      "readOnly": true,
      "minTier": 1,
      "learnedLoggedIn": false,
      "description": "One-way flights: Google's \"other departing flights\" list, sorted by price. Origin and destination take airport codes, metro codes (NYC) or city names. Per item: airline (names; several when carriers mix), price (USD, whole one-way itinerary), from/to (airports), departureTime/arrivalTime local [h,m] (missing entries are 0: [9] = 09:00, [null,56] = 00:56), arrivalDate [y,m,d] (the departure date is the one you asked for), durationMinutes, via (stop airports in order; absent for a nonstop flight)."
    },
