          "name": "destination",
          "type": "string",
          "required": true,
          "description": "destination airport IATA code, e.g. JFK (airports only: metro codes like NYC return nothing)",
          "example": "JFK",
          "pattern": "^(?!(?:NYC|WAS|CHI|DTT|YTO|YMQ|YEA|LON|PAR|MIL|ROM|STO|MOW|BUH|REK|TYO|OSA|SPK|SEL|BJS|JKT|BUE|SAO|RIO|BHZ)$)[A-Z]{3}$",
