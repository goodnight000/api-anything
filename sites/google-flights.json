        "format": "json",
        "contentType": "application/json; charset=utf-8",
        "xssiPrefix": ")]}'",
        "extract": "[0][0][2][1]",
        "pick": [
          "date=[0]",
          "price=[2][0][1]"
        ],
        "shape": {
          "[]": "array",
          "[][]": "array",
          "[][][]": "string"
        }
      },
      "params": [
        {
          "name": "origin",
          "type": "string",
          "required": true,
          "description": "origin airport IATA code, e.g. SFO (airports only: metro codes like NYC return nothing)",
          "example": "SFO",
          "pattern": "^(?!(?:NYC|WAS|CHI|DTT|YTO|YMQ|YEA|LON|PAR|MIL|ROM|STO|MOW|BUH|REK|TYO|OSA|SPK|SEL|BJS|JKT|BUE|SAO|RIO|BHZ)$)[A-Z]{3}$",
