          "example": "SFO",
          "pattern": "^\\D{2,60}$",
          "hint": "an airport code (JFK), a metro code (NYC, LON, TYO) or a city name (New York, Paris); Google reads it as free text"
        },
        {
          "name": "destination",
          "type": "string",
          "required": true,
          "description": "destination: airport code, metro code or city name, e.g. NYC",
          "example": "NYC",
          "pattern": "^\\D{2,60}$",
          "hint": "an airport code (JFK), a metro code (NYC, LON, TYO) or a city name (New York, Paris); Google reads it as free text"
        },
        {
          "name": "date",
          "type": "string",
          "required": true,
          "description": "departure date YYYY-MM-DD, today or later",
          "example": "2027-04-15",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "hint": "a departure date as YYYY-MM-DD, e.g. 2027-04-15"
