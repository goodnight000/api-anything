{
  "name": "google-flights",
  "displayName": "Google Flights",
  "baseUrl": "https://www.google.com",
  "description": "Logged-out one-way flight search and a cheapest-date price calendar on Google Flights. Prices in USD, en-US.",
  "operations": [
    {
