        },
        {
          "name": "start",
          "type": "string",
          "required": true,
          "description": "first departure date",
          "example": "2027-04-01",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "hint": "the first departure date, as YYYY-MM-DD"
        },
        {
          "name": "end",
          "type": "string",
          "required": true,
          "description": "last departure date, at most about 3 months after start",
          "example": "2027-04-30",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "hint": "the last departure date as YYYY-MM-DD, at most about 3 months after start"
        }
      ],
      "readOnly": true,
      "minTier": 1,
      "learnedLoggedIn": false,
      "description": "Cheapest one-way price per departure date between two airports, for every day from start to end (tested up to 3 months per call). Per item: date (YYYY-MM-DD), price (USD; missing when Google has no fare that day). Then call search/top with the cheapest date for the flights themselves."
    }
  ]
